# Server Configuration
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://student-activity-web.vercel.app

# Google OAuth 2.0 Credentials - set these in Render dashboard
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

OAUTH_GOOGLE_CALLBACK_URL=https://student-activity-api-w982.onrender.com/api/auth/oauth/google/callback

# Session Security - set this in Render dashboard
OAUTH_SESSION_SECRET=

CORS_ORIGIN=https://student-activity-web.vercel.app

# Database - set this in Render dashboard
DATABASE_URL=
