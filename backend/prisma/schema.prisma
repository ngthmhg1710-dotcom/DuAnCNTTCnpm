generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  STAFF
  ADMIN
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum DeclarationStatus {
  SUBMITTED
  PROCESSING
  VERIFIED
  NEEDS_MORE_INFO
  REJECTED
}

model User {
  id           Int           @id @default(autoincrement())
  username     String        @unique
  passwordHash String?
  oauthProvider String?
  oauthSubject String? @unique
  name         String
  email        String        @unique
  role         Role          @default(STUDENT)
  status       AccountStatus @default(ACTIVE)
  tokenVersion Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  student      Student?
  auditLogs    AuditLog[]
  notifications Notification[]
}


model Student {
  id         Int           @id @default(autoincrement())
  userId     Int           @unique
  mssv       String        @unique
  className  String?
  cohort     String?
  major      String?
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  participations Participation[]
  declarations Declaration[]
}

model Activity {
  id          Int      @id @default(autoincrement())
  externalId  String?  @unique
  title       String
  category    String
  unit        String?
  location    String?
  description String?
  imageUrl    String?  // URL ảnh hoặc data URL (frontend đã nén ~1200px JPEG)
  startAt     DateTime
  endAt       DateTime?
  capacity    Int?
  published   Boolean  @default(true)
  closed      Boolean  @default(false) // đóng đăng ký (hoạt động vẫn diễn ra)
  cancelled   Boolean  @default(false) // hủy hoạt động: giữ lại lịch sử, không tính điểm
  targetClasses String[] @default([])  // rỗng = mọi lớp
  targetCohorts String[] @default([])  // rỗng = mọi khóa
  ruleCode    String?  // mã mục trong quy chế ĐRL, vd "4.1b" (danh sách ở frontend/src/data/drl.ts)
  points      Int      @default(0) // điểm rèn luyện mỗi lần tham gia theo quy chế
  createdAt   DateTime @default(now())
  participations Participation[]
}

model Participation {
  id           Int      @id @default(autoincrement())
  studentId    Int
  activityId   Int
  status       String   @default("REGISTERED")
  registeredAt DateTime @default(now())
  joinedAt     DateTime?
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  activity     Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  @@unique([studentId, activityId])
}

model Declaration {
  id            Int               @id @default(autoincrement())
  code          String            @unique
  studentId     Int
  activityName  String
  unit          String
  submittedAt   DateTime          @default(now())
  status        DeclarationStatus  @default(SUBMITTED)
  handler       String?
  reviewNote    String?
  details       Json?
  student       Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Integration {
  id         Int      @id @default(autoincrement())
  name       String
  baseUrl    String
  authType   String   @default("API_KEY")
  dataType   String   @default("STUDENTS") // STUDENTS | ACTIVITIES
  apiKey     String?
  isActive   Boolean  @default(true)
  lastSyncAt DateTime?
  createdAt  DateTime @default(now())
  syncLogs   SyncLog[]
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  object    String
  objectId  String?
  status    String   @default("SUCCESS")
  detail    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([createdAt])
}

model RoleDef {
  id     Int    @id @default(autoincrement())
  name   String @unique
  desc   String @default("")
  status String @default("Hoạt động")
}

model Semester {
  id        Int        @id @default(autoincrement())
  name      String
  year      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean    @default(false)
  criteria  Criteria[]
}

// group trùng với Activity.category; tiến độ = số lần ATTENDED trong học kỳ
model Criteria {
  id          Int      @id @default(autoincrement())
  semesterId  Int
  group       String
  name        String
  description String?
  requirement Int      @default(1)
  points      Int      @default(0) // điểm tối đa của tiêu chí; đạt đủ mức yêu cầu -> đủ điểm, chưa đủ -> tính theo tỉ lệ
  semester    Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
}

// Danh mục dùng chung. type: ACTIVITY (loại hoạt động) | UNIT (đơn vị tổ chức) | CRITERIA_GROUP (nhóm tiêu chí).
// Activity.category / Activity.unit / Criteria.group lưu theo tên, nên đổi tên danh mục sẽ cập nhật theo.
model Category {
  id   Int    @id @default(autoincrement())
  type String
  name String

  @@unique([type, name])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  senderId  Int?
  batchId   String?
  title     String
  message   String
  type      String   @default("Nhắc nhở")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model SyncLog {
  id            Int      @id @default(autoincrement())
  integrationId Int
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  source        String   @default("Kéo") // Kéo: hệ thống gọi đối tác | Đẩy: đối tác gọi vào
  records       Int      @default(0)
  success       Int      @default(0)
  failed        Int      @default(0)
  status        String   @default("Thành công")
  error         String?
  startedAt     DateTime @default(now())
  durationMs    Int      @default(0)
  errors        SyncError[]
}

// Một bản ghi lỗi của một lần đồng bộ: lưu lý do và dữ liệu gốc để xem chi tiết và thử lại.
model SyncError {
  id        Int      @id @default(autoincrement())
  syncLogId Int
  syncLog   SyncLog  @relation(fields: [syncLogId], references: [id], onDelete: Cascade)
  rowIndex  Int
  key       String?  // MSSV / externalId / mã khai báo của dòng lỗi
  reason    String
  raw       Json?
  attempts  Int      @default(0)
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([syncLogId])
}

// Cấu hình dạng khóa → JSON (hiện dùng cho ngưỡng cảnh báo sinh viên: key "alerts").
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
